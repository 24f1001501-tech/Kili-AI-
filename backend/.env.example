# Copy this file to .env and fill in the values. Never commit .env.

# Sarvam AI (https://dashboard.sarvam.ai) — speech-to-text + reference audio.
# New accounts get ₹100 free credit (~3 hours of speech-to-text).
SARVAM_API_KEY=

# saaras:v3 supports mode=verbatim (less autocorrection of mispronounced words).
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
# Optional voice, e.g. "kavitha" or "anand" for bulbul:v3. Empty = Sarvam default.
SARVAM_TTS_SPEAKER=

# Local phoneme model: auto (load if torch is installed) | off
PHONEME_ENGINE=auto
PHONEME_MODEL_ID=facebook/wav2vec2-xlsr-53-espeak-cv-ft
